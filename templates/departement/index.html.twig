{% extends "base.html.twig" %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des Départements</h1>
    </div>

    <!-- Enregistrement d'un Département -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        {{ form_widget(formDept.nom) }}
                    </div>
                    <div class="text-danger">{{ form_errors(formDept.nom) }}</div>
                </div>
                <div class="col-md-2">
                    {{ form_widget(formDept.saveDepartement ) }}
                </div>
            </div>
            {{ form_end(formDept) }}
        </div>
    </div>

    <!-- Liste des Départements -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="text-center">Name</th>
                            <th class="text-center">Date Creation</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Nbre Employe</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for departement in departements %}
                            <tr>
                                <td class="text-center">{{ departement.nom }}</td>
                                <td class="text-center">{{ departement.createdAt|date("d/m/Y") }}</td>
                                <td class="text-center">
                                    {% if departement.isActive %}
                                        <span class="badge bg-success">Actif</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Inactif</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">{{ departement.employes|length }}</td>
                                <td class="text-center">
                                    <a href="{{ path('app_employe_list', { idDept: departement.id }) }}"
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> Voir Employes
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">
                                    <div class="alert alert-danger" role="alert">
                                        La liste de départements est vide
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination intégrée directement -->
            {% if nbrePage > 1 %}
                    <nav>
                        <ul class="pagination justify-content-center mt-3">

                            {# Précédent #}
                            <li class="page-item {% if pageEncours <= 1 %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{{ path('app_departement_list', { page: pageEncours-1 }) }}">
                                    Précédent
                                </a>
                            </li>

                            {# Numéros #}
                            {% for i in 1..nbrePage %}
                                <li class="page-item {% if i == pageEncours %}active{% endif %}">
                                    <a class="page-link"
                                       href="{{ path('app_departement_list', { page: i }) }}">
                                        {{ i }}
                                    </a>
                                </li>
                            {% endfor %}

                            {# Suivant #}
                            <li class="page-item {% if pageEncours >= nbrePage %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{{ path('app_departement_list', { page: pageEncours+1 }) }}">
                                    Suivant
                                </a>
                            </li>

                        </ul>
                    </nav>
                {% endif %}
        </div>
    </div>
</div>
{% endblock %}
