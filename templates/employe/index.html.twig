{% extends "base.html.twig" %}
    {% block body %}
    <!-- Contenu principal -->
       <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Liste des Employes </h2>
                <a href="{{ path("app_employe_add") }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Nouveau Employe
                </a>
        </div>
        <!-- Filtres et recherche -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">

                    <form method="get">
                        <div class="row g-3 align-items-center">

                            {# Barre de recherche #}
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input type="text" 
                                        class="form-control" 
                                        name="search"
                                        value="{{ search|default("") }}"
                                        placeholder="Rechercher par téléphone">
                                    <button class="btn btn-outline-secondary">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>

                            {# Filtre département #}
                            <div class="col-md-4">
                                <select name="idDept" 
                                        class="form-select"
                                        onchange="this.form.submit()">

                                    <option value=""> Départements </option>

                                    {% for departement in departements %}
                                        <option value="{{ departement.id }}"
                                            {% if idDept == departement.id %}selected{% endif %}>
                                            {{ departement.nom }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                        </div>
                    </form>

                </div>
        </div>


        
        <!-- Liste des comptes -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
            {% if employes|length >0 %}
                  <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="text-center">Nom et Prenom</th>
                                <th class="text-center">Telephone</th>
                                <th class="text-center">Date Embauche</th>
                                <th class="text-center">Statut</th>
                                <th class="text-center">Departement</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for employe in employes %}
                            <tr>
                                <td class="text-center">{{employe.nom}}</td>
                                <td class="text-center">{{employe.tel}}</td>
                                <td class="text-center">{{employe.createdAt|date("d/m/Y")}}</td>
                                <td class="text-center"> {% include "partials/statut.html.twig" with {
                                    active: employe.isActive,
                                    color: employe.isActive ? "success" : "secondary"
                                } %}
                                </td>
                                <td class="text-center">{{ employe.departement.nom }}</td>

                            </tr>
                            {% endfor %}
                           
                        </tbody>
                    </table>
                </div>
            <!-- Pagination intégrée directement -->
                    {% include "partials/pagination.html.twig" with {
                        nbrePage: nbrePage,
                        pageEncours: pageEncours,
                        pathName: "app_employe_list"
                    } %}
                 {% else %}
                           <div class="text-center alert alert-danger" role="alert">
                                Cette liste est vide
                           </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

 