{% extends "base.html.twig" %}
      {% block body %}
    <!-- Contenu principal -->
       <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Liste des Employes </h2>
                <a href="#" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Nouveau Employe
                </a>
        </div>
        <!-- Filtres et recherche -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

        <form method="get">
            <div class="row g-3 align-items-center">

                {# Barre de recherche #}
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" 
                               class="form-control" 
                               name="search"
                               value="{{ search|default('') }}"
                               placeholder="Rechercher par téléphone">

                        <button class="btn btn-outline-secondary">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>

                {# Filtre département #}
                <div class="col-md-4">
                    <select name="idDept" 
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value=""> Départements </option>

                        {% for departement in departements %}
                            <option value="{{ departement.id }}"
                                {% if idDept == departement.id %}selected{% endif %}>
                                {{ departement.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

            </div>
        </form>

    </div>
</div>


        
        <!-- Liste des comptes -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
            {% if employes|length >0 %}
                  <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="text-center">Nom et Prenom</th>
                                <th class="text-center">Telephone</th>
                                <th class="text-center">Date Embauche</th>
                                <th class="text-center">Statut</th>
                                <th class="text-center">Departement</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for employe in employes %}
                            <tr>
                                <td class="text-center">{{employe.nom}}</td>
                                <td class="text-center">{{employe.tel}}</td>
                                <td class="text-center">{{employe.createdAt|date("d/m/Y")}}</td>
                                <td class="text-center">
                                        {% if employe.isActive %}
                                            <span class="badge bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inactif</span>
                                        {% endif %}
                                </td>
                                <td class="text-center">{{ employe.departement.nom }}</td>

                            </tr>
                            {% endfor %}
                           
                        </tbody>
                    </table>
                </div>
                {% if nbrePage > 1 %}
                        <nav>
                            <ul class="pagination justify-content-center mt-3">

                                {# Bouton Précédent #}
                                <li class="page-item {% if pageEncours <= 1 %}disabled{% endif %}">
                                    <a class="page-link"
                                    href="{{ path('app_employe_list', { idDept: idDept|default(null), page: pageEncours-1 }) }}">
                                        Précédent
                                    </a>
                                </li>

                                {# Numéros de page #}
                                {% for i in 1..nbrePage %}
                                    <li class="page-item {% if i == pageEncours %}active{% endif %}">
                                        <a class="page-link"
                                        href="{{ path('app_employe_list', { idDept: idDept|default(null), page: i }) }}">
                                            {{ i }}
                                        </a>
                                    </li>
                                {% endfor %}

                                {# Bouton Suivant #}
                                <li class="page-item {% if pageEncours >= nbrePage %}disabled{% endif %}">
                                    <a class="page-link"
                                    href="{{ path('app_employe_list', { idDept: idDept|default(null), page: pageEncours+1 }) }}">
                                        Suivant
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    {% endif %}
                 {% else %}
                           <div class="text-center alert alert-danger" role="alert">
                                Cette liste est vide
                           </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

 