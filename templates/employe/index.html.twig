<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Liste des Employés</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">

<div class="max-w-6xl mx-auto">

    <!-- Titre et bouton Ajouter -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Liste des Employés</h1>
        
    </div>

    <!-- Formulaire de filtre -->
    <form method="get" class="mb-6 flex items-center space-x-2">

        <select name="departement_id" class="border rounded px-3 py-2">
            <option value="">Tous les départements</option>
            {% for departement in departements %}
                <option value="{{ departement.id }}"
                    {% if departement.id == selectedDepartementId %}selected{% endif %}>
                    {{ departement.nom }}
                </option>
            {% endfor %}
        </select>

        <button type="submit"
                class="bg-blue-400 hover:bg-blue-500 text-white font-bold py-2 px-4 rounded">
            Filtrer
        </button>
    </form>

    <!-- Tableau des employés -->
    <div class="bg-white shadow-lg rounded-lg overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-blue-200 text-gray-700">
                <tr>
                    <th class="px-4 py-3 text-center">ID</th>
                    <th class="px-4 py-3 text-center">Nom</th>
                    <th class="px-4 py-3 text-center">Téléphone</th>
                    <th class="px-4 py-3 text-center">Spécialité</th>
                    <th class="px-4 py-3 text-center">Département</th>
                    <th class="px-4 py-3 text-center">Statut</th>
                    <th class="px-4 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-300">
                {% for employe in employes %}
                    <tr class="hover:bg-gray-50 text-center">
                        <td class="px-4 py-2">{{ employe.id }}</td>
                        <td class="px-4 py-2">{{ employe.nom }}</td>
                        <td class="px-4 py-2">{{ employe.tel ?: '-' }}</td>
                        <td class="px-4 py-2">{{ employe.specialite.value }}</td>
                        <td class="px-4 py-2">{{ employe.departement.nom }}</td>
                        <td class="px-4 py-2">{{ employe.isActive ? 'Actif' : 'Archivé' }}</td>
    
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="py-4 text-center text-gray-500">Aucun employé trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>

</body>
</html>
