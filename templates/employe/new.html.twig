<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Ajouter un Employé</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-6">

    <div class="bg-white shadow-lg rounded-lg w-full max-w-lg p-8">
        <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Ajouter un Employé</h1>

        {# Affichage des messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 px-4 py-2 rounded {{ label == 'success' ? 'bg-green-200 text-green-800' : 'bg-red-200 text-red-800' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <form method="post" class="space-y-4">
            <div>
                <label class="block mb-1 font-semibold text-gray-700">Nom *</label>
                <input type="text" name="nom" required
                       class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <div>
                <label class="block mb-1 font-semibold text-gray-700">Téléphone</label>
                <input type="text" name="tel"
                       class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <div>
                <label class="block mb-1 font-semibold text-gray-700">Salaire</label>
                <input type="number" name="salaire" step="0.01"
                       class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <div>
                <label class="block mb-1 font-semibold text-gray-700">Spécialité *</label>
                <select name="specialite" required
                        class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">-- Sélectionner --</option>
                    <option value="FULLSTACK">Full Stack</option>
                    <option value="BACKEND">Back-End</option>
                    <option value="FRONTEND">Front-End</option>
                </select>

            </div>

            <div>
                <label class="block mb-1 font-semibold text-gray-700">Département *</label>
                <select name="departement_id" required
                        class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">-- Sélectionner --</option>
                    {% for departement in departements %}
                        <option value="{{ departement.id }}">{{ departement.nom }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex justify-between items-center">
                <button type="submit"
                    class="bg-blue-400 hover:bg-blue-500 text-white font-bold py-3 px-6 rounded-lg shadow-md transition duration-300">
                    Ajouter
                </button>
                <a href="{{ path('employe_index') }}"
                    class="text-blue-500 hover:text-blue-700 font-semibold py-3 px-6 rounded-lg shadow-md transition duration-300">
                    Annuler
                </a>
            </div>
        </form>
    </div>

</body>
</html>
